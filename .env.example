# local|dev: admin routes allow missing ADMIN_API_KEY (open). staging|prod: ADMIN_API_KEY required or admin returns 503.
APP_ENV=local
LOG_LEVEL=INFO

# Local sqlite default for standalone ACA.
DATABASE_URL=sqlite:///./astro_content_agent.db

OPENAI_API_KEY=
OPENAI_MODEL=omni-mini

# Local assets served at /media/*
ASSETS_DIR=./assets
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_MODE=local

# Protect admin routes. When set, require X-Admin-Key on /api/v1/admin/*. When unset: allowed only for APP_ENV=local|dev.
# /operator/review is only mounted for local|dev, or whenever ADMIN_API_KEY is non-empty.
ADMIN_API_KEY=

# Instagram publishing (required only for real publish paths)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# Scheduler controls
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
DAILY_GENERATION_HOUR=6
PUBLISH_QUEUE_INTERVAL_MINUTES=5
ANALYTICS_REFRESH_HOUR=8
